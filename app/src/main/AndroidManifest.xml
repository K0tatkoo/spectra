<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The floating overlay. Granted through a Settings screen, never a dialog. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The only reason this app touches the network at all: asking
      n3d-store.com whether there is a newer version and fetching it.
      No audio and nothing measured from it is ever transmitted.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Installing an update the app downloaded itself. This is not a licence to
      install silently: Android still shows its own confirmation, and the user
      has to switch this app on under "Install unknown apps" before the prompt
      will even appear. See update/Updater.kt.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".SpectraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spectra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.Spectra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            One service owns everything that outlives the Activity: the capture
            thread, the lock-screen notification, the floating overlay and the
            widget pushes. Two services would mean two copies of the ring buffer.

            Both types are declared; the one actually passed to startForeground()
            is chosen at runtime from the selected source, because Android 14+
            rejects a mediaProjection-typed service that has no consent token.
        -->
        <service
            android:name=".service.AnalyzerService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />

        <receiver
            android:name=".widget.SpectraWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spectra_widget_info" />
        </receiver>

        <!-- Notification action buttons post back here rather than to the service
             directly, so a tap works identically from the lock screen. -->
        <receiver
            android:name=".service.NotificationActionReceiver"
            android:exported="false" />

    </application>

</manifest>
